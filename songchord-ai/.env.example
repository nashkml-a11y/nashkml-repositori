# Copy this file to .env and fill in the values before running docker compose up.

# --- OpenAI (backend/worker only — NEVER exposed to the frontend) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_STT_MODEL=whisper-1

# --- Database (docker-compose overrides host to the postgres service; only
# change these if you run Postgres outside docker-compose) ---
DATABASE_URL=postgresql+psycopg2://songchord:songchord@postgres:5432/songchord

# --- Redis / Celery broker ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
STORAGE_DIR=/data/storage
MAX_UPLOAD_BYTES=52428800

# --- CORS (JSON array of allowed origins for the frontend dev server) ---
CORS_ORIGINS=["http://localhost:3000"]
