{
  "name": "buscador-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API backend (Cloudflare Worker + D1) for the home object finder PWA",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create buscador-db",
    "db:migrate:local": "wrangler d1 migrations apply buscador-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply buscador-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "hono": "^4.13.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.125.0"
  }
}
