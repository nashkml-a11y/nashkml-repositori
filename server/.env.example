# Puerto en el que escucha la API
PORT=3001

# Clave de la API de Anthropic (Claude). Nunca se expone al navegador:
# solo la usa este servidor backend.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Ruta del fichero de base de datos SQLite
DATABASE_PATH=./data/buscador.db
